    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-perfectionist": "^5.9.0",
